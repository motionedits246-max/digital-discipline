<resources>
    <plurals name="app_opens">
        <item quantity="one">%d open</item>
        <item quantity="other">%d opens</item>
    </plurals>
    <color name="launcher_background">#0B0812</color>
    <string name="block_service_description">Checks which app opens and shows a blocking notice for selected apps. Digital Discipline does not read screen contents.</string>
    <string name="app_blocked">App blocked</string>
    <string name="blocked_by_parent">%1$s is blocked by your parent.</string>
    <string name="blocked_by_rule">%1$s is blocked by your rule.</string>
    <string name="app_list_count">%1$d apps · %2$d selected to block</string>
    <string name="block_app_switch">Block %1$s</string>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#15111E</item>
        <item name="android:statusBarColor">#15111E</item>
        <item name="android:navigationBarColor">#15111E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#D7BDFF</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
